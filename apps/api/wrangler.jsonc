{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nano-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs / Observability:
  // logs 开启后 console 输出与未捕获异常会自动写入账号级的 Workers Logs,
  // 在 Dashboard 该 Worker 详情的 Logs 标签页查询,也可 `wrangler tail` 实时查看;
  // traces 开启后平台自动打点(fetch/DO/D1/R2/Service Binding),且 trace 上下文
  // 自动跨 Service Binding 与 DO 传播——跨 Worker/DO 的链路无需代码关联,
  // 应用侧的 request_id 经 span 属性 app.request_id 桥进 trace。
  // head_sampling_rate = 1 表示 100% 采样(默认);线上流量大时可调低(如 0.1)控制成本
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },

  // D1 元数据库。骨架阶段 database_id 为占位:
  // 运行 `wrangler d1 create nano-api-db` 后把返回的 database_id 填进来
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nano-api-db",
      "database_id": "620fc56f-afb3-4636-bf1c-70677dcaf031"
    }
  ],

  // File 内容存储(docs/files/schema.md)。bucket_name 为占位:
  // 运行 `wrangler r2 bucket create nano-files` 后即可本地/线上一致使用
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nano-files" }],

  // Agent 循环的模型服务(docs/session/runtime.md §1):Cloudflare AI Gateway
  // REST API(OpenAI chat 格式)。CLOUDFLARE_ACCOUNT_ID 与 AI_GATEWAY_ID
  // 是非敏感配置(deploy.sh 会自动回填/查找/创建网关 nano);CLOUDFLARE_API_TOKEN
  // 走 secret(不进仓库):`wrangler secret put CLOUDFLARE_API_TOKEN`
  // (需 Account > Workers AI > Read 权限)。测试经 vitest 的 miniflare 绑定把
  // AI_API_BASE 指向本地 mock 上游
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "6b4a1467a610d4bfb174c7a18f62f160",
    "AI_GATEWAY_ID": "nano"
  },

  // 会话运行时(docs/session/runtime.md):每会话一个实例,SQLite 存储
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDo" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDo"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],

  // 工具沙箱(docs/session/runtime.md §4.5):Sandbox SDK 的容器运行时,
  // 镜像钉在与 npm 包一致的版本(官方要求二者同步)
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./sandbox.Dockerfile",
      "instance_type": "lite",
      "max_instances": 5
    }
  ]

  // agent-loop Workflow 绑定已弃用:Agent 循环在 SESSION_DO 内自管执行,
  // 决策记录见 docs/session/runtime.md §0
}
