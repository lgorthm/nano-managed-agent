{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nano-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 元数据库。骨架阶段 database_id 为占位:
  // 运行 `wrangler d1 create nano-api-db` 后把返回的 database_id 填进来
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nano-api-db",
      "database_id": "TODO-run-wrangler-d1-create"
    }
  ],

  // File 内容存储(docs/files/schema.md)。bucket_name 为占位:
  // 运行 `wrangler r2 bucket create nano-files` 后即可本地/线上一致使用
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nano-files" }],

  // Agent 循环的模型服务(docs/session/runtime.md §1)。GLM_API_KEY 走
  // secret(不进仓库):`wrangler secret put GLM_API_KEY`;测试经 vitest
  // 的 miniflare 绑定把 GLM_API_BASE 指向本地 mock 上游
  "vars": {
    "GLM_API_BASE": "https://open.bigmodel.cn/api/paas/v4"
  },

  // 会话运行时(docs/session/runtime.md):每会话一个实例,SQLite 存储
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDo"] }]

  // agent-loop Workflow 绑定已弃用:Agent 循环在 SESSION_DO 内自管执行,
  // 决策记录见 docs/session/runtime.md §0
}
