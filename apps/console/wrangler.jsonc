{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nano-console",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs / Observability:
  // logs 开启后 console 输出与未捕获异常会自动写入账号级的 Workers Logs,
  // 在 Dashboard 该 Worker 详情的 Logs 标签页查询,也可 `wrangler tail` 实时查看;
  // traces 开启后平台自动打点(fetch/DO/Service Binding),trace 上下文自动跨
  // Service Binding 传播(→ nano-api 同一条 trace);应用侧 request_id 经
  // span 属性 app.request_id 桥进 trace。
  // head_sampling_rate = 1 表示 100% 采样(默认);线上流量大时可调低(如 0.1)控制成本
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },

  // SPA 静态资源:directory 由 @cloudflare/vite-plugin 在构建时自动指向
  // vite 产物(dist/client),不要手动设置;not_found_handling 负责 SPA 路由回退,
  // 导航请求未命中资源时由平台直接返回 index.html,不会进入 worker。
  "assets": {
    "not_found_handling": "single-page-application"
  },

  // Cloudflare Access 应用标识(非敏感配置,不是密钥):
  // Zero Trust → Access → Applications → 对应应用的 Additional settings 里
  // 复制 Team Domain 与 Application Audience (AUD) Tag,配置步骤见 docs/console.md
  "vars": {
    "NANO_API_BASE": "https://nano-api.maybelxr.workers.dev",
    "CF_ACCESS_TEAM_DOMAIN": "https://shiny-butterfly-54b9.cloudflareaccess.com",
    "CF_ACCESS_AUD": "3c0a97892c424dccf366c362e3f9c1b0d635a7f5cc2adec8e42d4f1f709ebb06"
  },

  // GLM_API_KEY 走 secret(不进仓库):`wrangler secret put GLM_API_KEY`,
  // 本地开发写入 .dev.vars(模板见 .dev.vars.example)

  // nano 后端的传输通道:Service Binding 直连本仓库 apps/api 部署出的 nano-api
  // Worker。Cloudflare 不允许同账号 Worker 之间用普通 fetch 互访(边缘直接回
  // 404 "error code: 1042"),服务绑定是官方通道:绑定的 fetch 忽略 URL 主机,
  // 直接路由到目标 Worker,路径与查询串仍由 proxy.ts 按 NANO_API_BASE 构造。
  // 本地 vite dev 不建立该绑定,代码在无绑定时回退普通 fetch(连本地 127.0.0.1:8787)。
  "services": [{ "binding": "NANO_API_SERVICE", "service": "nano-api" }]
}
