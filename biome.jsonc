{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/dist",
      "!**/coverage",
      "!**/worker-configuration.d.ts",
      "!**/migrations",
      "!.vscode"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // 仓库既有代码大量使用非空断言(179 处),强行消除属高风险重构,先关闭
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // 展示型列表(骨架屏、只读 tabs、虚拟滚动)以 index 作 key 是安全的,降为提示级
        "noArrayIndexKey": "warn"
      },
      "a11y": {
        // radix/自定义控件让静态分析认不出 label 关联;favicon 为装饰图;fieldset 难以套用现有样式,均降为提示级
        "noLabelWithoutControl": "warn",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
